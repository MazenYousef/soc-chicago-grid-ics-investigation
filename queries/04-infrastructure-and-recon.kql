// Phase 4 - Actor infrastructure and pre-attack reconnaissance

// Domain -> IP
PassiveDns
| where domain contains "citygridsolutions.net"
| distinct ip

// IP -> other domains on the same infrastructure
PassiveDns
| where ip == "87.250.252.242"
| distinct domain

// All IPs behind the three actor domains  -> 87.250.252.242, 104.244.42.129
PassiveDns
| where domain in ("citygridsolutions.net", "infrastructurewatch.org", "chicagogridupdates.com")
| distinct ip

// What did those IPs look at on our website? (SCADA operators, events)
InboundNetworkEvents
| where src_ip in ("104.244.42.129", "87.250.252.242")
| where url contains "operator"
| project timestamp, src_ip, url

InboundNetworkEvents
| where src_ip in ("104.244.42.129", "87.250.252.242")
| project timestamp, src_ip, url
| order by timestamp asc
